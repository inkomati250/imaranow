# Byte-compiled / cache files
*.py[cod]
__pycache__/

# Virtual environment
venv/

# Environment variables
.env

# SQLite DB (if ever used again)
db.sqlite3

# Media files (user uploads)
media/

# Collected static files (production)
staticfiles/

# Local static files (usually tracked but if you want to ignore, uncomment)
# static/

# Editor directories and IDE settings
.vscode/
.idea/

# Log files
nohup.out

# Unix sockets and runtime files
*.sock

# Test scripts (optional)
test_*.py

